<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trijal Restaurant | The Privé Experience</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0a0a0a; color: #e2e8f0; scroll-behavior: smooth; }
        h1, h2, h3, .serif { font-family: 'Playfair Display', serif; }
        
        .gold-text { color: #f5c518; }
        .gold-bg { background-color: #f5c518; }
        .gold-border { border-color: #f5c518; }

        .menu-category-btn.active { color: #f5c518; border-bottom: 2px solid #f5c518; }
        
        .reveal-on-scroll { opacity: 0; transform: translateY(20px); transition: all 0.6s ease-out; }
        .reveal-on-scroll.active { opacity: 1; transform: translateY(0); }

        .glass { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.05); }
    </style>
</head>
<body>

    <nav class="fixed top-0 w-full z-50 px-8 py-4 flex justify-between items-center bg-black/90 backdrop-blur-md border-b border-white/10">
        <div class="text-2xl font-bold serif tracking-widest text-white">TRIJAL <span class="gold-text">.</span></div>
        <div class="hidden md:flex space-x-8 text-xs uppercase tracking-widest font-light">
            <a href="#home" class="hover:gold-text transition">Home</a>
            <a href="#menu" class="hover:gold-text transition">Menu</a>
            <a href="#about" class="hover:gold-text transition">Experience</a>
            <a href="#reserve" class="hover:gold-text transition">Reservations</a>
        </div>
        <a href="#reserve" class="gold-bg text-black px-6 py-2 text-xs font-bold uppercase tracking-tighter hover:bg-yellow-500 transition">Book Table</a>
    </nav>

    <header id="home" class="relative h-screen flex items-center justify-center overflow-hidden">
        <img src="image_4.png" class="absolute inset-0 w-full h-full object-cover opacity-40 grayscale" alt="Exterior">
        <div class="z-10 text-center px-4">
            <span class="gold-text tracking-[0.6em] text-xs uppercase mb-4 block">Bicholi Mardana, Indore</span>
            <h1 class="text-7xl md:text-9xl font-bold mb-6 serif italic">The Privé</h1>
            <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto font-light leading-relaxed">
                Experience Indore's most exclusive culinary sanctuary.
            </p>
        </div>
    </header>

    <section id="about" class="py-24 bg-[#0f0f0f] px-8">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center">
                <div class="reveal-on-scroll">
                    <img src="image_1.png" alt="Ambiance" class="rounded-xl grayscale hover:grayscale-0 transition duration-700 shadow-2xl">
                </div>
                <div class="reveal-on-scroll">
                    <h2 class="text-5xl font-bold mb-6 serif">The Ambiance</h2>
                    <p class="text-gray-400 mb-8 leading-relaxed">
                        Our space is designed for those who appreciate the finer details. From the curated artwork to the custom-built furniture on our terrace, Trijal offers a visual feast before the first course is even served.
                    </p>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="glass p-4 rounded-lg">
                            <h4 class="gold-text font-bold mb-1">Rooftop</h4>
                            <p class="text-xs text-gray-500">Intimate Dining</p>
                        </div>
                        <div class="glass p-4 rounded-lg">
                            <h4 class="gold-text font-bold mb-1">Privé</h4>
                            <p class="text-xs text-gray-500">Exclusive Access</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="menu" class="py-24 px-4 bg-black">
        <div class="max-w-5xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-5xl font-bold serif mb-4">Our Curation</h2>
                <div class="h-1 w-20 gold-bg mx-auto"></div>
            </div>

            <div class="grid md:grid-cols-2 gap-x-16 gap-y-12">
                
                <div class="reveal-on-scroll">
                    <h3 class="gold-text serif text-2xl mb-6 border-b border-white/10 pb-2">Tandoori Bahar</h3>
                    <div class="space-y-6">
                        <div class="flex justify-between items-baseline group">
                            <div>
                                <h4 class="text-lg group-hover:gold-text transition">Chaman A Jalapeno</h4>
                                <p class="text-xs text-gray-500 italic">Cottage cheese, fusion Indo-Mexican</p>
                            </div>
                            <span class="font-bold">369</span>
                        </div>
                        <div class="flex justify-between items-baseline group">
                            <div>
                                <h4 class="text-lg group-hover:gold-text transition">Paneer Nazrana</h4>
                                <p class="text-xs text-gray-500 italic">Cottage cheese with smoked Indian spices</p>
                            </div>
                            <span class="font-bold">349</span>
                        </div>
                        <div class="flex justify-between items-baseline group">
                            <div>
                                <h4 class="text-lg group-hover:gold-text transition">Dahi Ki Nazakat Kebab</h4>
                                <p class="text-xs text-gray-500 italic">Hung curd kebabs, mild taste</p>
                            </div>
                            <span class="font-bold">289</span>
                        </div>
                    </div>
                </div>

                <div class="reveal-on-scroll">
                    <h3 class="gold-text serif text-2xl mb-6 border-b border-white/10 pb-2">Indian Main Course</h3>
                    <div class="space-y-6">
                        <div class="flex justify-between items-baseline group">
                            <div>
                                <h4 class="text-lg group-hover:gold-text transition">Paneer Rajwadi Masala</h4>
                                <p class="text-xs text-gray-500 italic">Stuffed paneer in cheese sauce</p>
                            </div>
                            <span class="font-bold">349</span>
                        </div>
                        <div class="flex justify-between items-baseline group">
                            <div>
                                <h4 class="text-lg group-hover:gold-text transition">Paneer Volcano</h4>
                                <p class="text-xs text-gray-500 italic">Smoky, nutty & creamy flavour</p>
                            </div>
                            <span class="font-bold">339</span>
                        </div>
                        <div class="flex justify-between items-baseline group">
                            <div>
                                <h4 class="text-lg group-hover:gold-text transition">Vegetable Handi Lazeez</h4>
                                <p class="text-xs text-gray-500 italic">Mix vegetable with cream cheese</p>
                            </div>
                            <span class="font-bold">289</span>
                        </div>
                    </div>
                </div>

                <div class="reveal-on-scroll">
                    <h3 class="gold-text serif text-2xl mb-6 border-b border-white/10 pb-2">Global Station</h3>
                    <div class="space-y-6">
                        <div class="flex justify-between items-baseline group">
                            <div>
                                <h4 class="text-lg group-hover:gold-text transition">Mexican Sheriff Sizzler</h4>
                                <p class="text-xs text-gray-500 italic">Exotic veg, tex mex rice, seasoned potato</p>
                            </div>
                            <span class="font-bold">489</span>
                        </div>
                        <div class="flex justify-between items-baseline group">
                            <div>
                                <h4 class="text-lg group-hover:gold-text transition">Cheesy Alfredo Pasta</h4>
                                <p class="text-xs text-gray-500 italic">Cheese sauce with exotic veggies</p>
                            </div>
                            <span class="font-bold">319</span>
                        </div>
                    </div>
                </div>

                <div class="reveal-on-scroll">
                    <h3 class="gold-text serif text-2xl mb-6 border-b border-white/10 pb-2">Desi Baharein</h3>
                    <div class="space-y-6">
                        <div class="flex justify-between items-baseline group">
                            <div>
                                <h4 class="text-lg group-hover:gold-text transition">Sev Tamater / Doodh Sev</h4>
                                <p class="text-xs text-gray-500 italic">Indore's classic comfort preparation</p>
                            </div>
                            <span class="font-bold">259</span>
                        </div>
                        <div class="flex justify-between items-baseline group">
                            <div>
                                <h4 class="text-lg group-hover:gold-text transition">Trijal Dal Bagar</h4>
                                <p class="text-xs text-gray-500 italic">Our signature tempered lentils</p>
                            </div>
                            <span class="font-bold">289</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <section id="reserve" class="py-24 px-4 bg-[#0a0a0a]">
        <div class="max-w-3xl mx-auto glass p-12 rounded-3xl reveal-on-scroll">
            <div class="text-center mb-10">
                <h2 class="text-4xl font-bold serif mb-2">Reserve a Table</h2>
                <p class="text-gray-500 uppercase tracking-widest text-xs">Join the Privé Circle</p>
            </div>
            <form class="grid md:grid-cols-2 gap-6">
                <input type="text" placeholder="Full Name" class="bg-transparent border-b border-white/20 py-3 focus:border-[#f5c518] outline-none">
                <input type="tel" placeholder="Phone Number" class="bg-transparent border-b border-white/20 py-3 focus:border-[#f5c518] outline-none">
                <input type="date" class="bg-transparent border-b border-white/20 py-3 focus:border-[#f5c518] outline-none text-gray-500">
                <select class="bg-transparent border-b border-white/20 py-3 focus:border-[#f5c518] outline-none text-gray-500">
                    <option>2 Persons</option>
                    <option>4 Persons</option>
                    <option>6+ Persons</option>
                </select>
                <button class="md:col-span-2 gold-bg text-black font-bold py-4 rounded-full mt-6 hover:scale-105 transition-transform uppercase tracking-widest text-sm">Request Invitation</button>
            </form>
        </div>
    </section>

    <footer class="py-12 border-t border-white/10 px-8 text-center md:text-left">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
            <div>
                <h3 class="serif text-xl gold-text mb-2">TRIJAL</h3>
                <p class="text-xs text-gray-500 tracking-widest uppercase">Bicholi Mardana, Indore, MP 452016</p>
            </div>
            <div class="flex space-x-6 text-gray-400">
                <a href="#" class="hover:gold-text">Instagram</a>
                <a href="#" class="hover:gold-text">Facebook</a>
                <a href="#" class="hover:gold-text">WhatsApp</a>
            </div>
        </div>
    </footer>

    <script>
        // Scroll Reveal Logic
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('active');
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el));
    </script>
</body>
</html>
